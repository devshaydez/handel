# Local-only Handel advisory API configuration.
# Keep NEARAI_API_KEY in your shell/secret manager; never put it in frontend code.
NEARAI_API_KEY=
HANDEL_OPTIONS_CONTRACT_ID=options.shaydez.testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
HANDEL_HOST=127.0.0.1
HANDEL_PORT=8787
HANDEL_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Explicit process-local request reservation limits (micro-USD units).
# Configure these against the current provider pricing before live use.
HANDEL_AI_BUDGET_MICROS=
HANDEL_AI_MAX_REQUEST_COST_MICROS=
HANDEL_AI_MAX_REQUESTS=5
HANDEL_AI_MAX_COMPLETION_TOKENS=4096
HANDEL_AI_MAX_PROMPT_BYTES=16000

# Fixed simulation fixture only. Never use this as a live quote.
HANDEL_DEMO_PREMIUM_FIXTURE=5000000


# Restricted delegated Testnet execution (server-side only)
# Never put these values in VITE_* frontend variables or chat.
NEAR_AGENT_ACCOUNT_ID=handel-agent.shaydez.testnet
NEAR_AGENT_DELEGATED_FUNCTION_CALL_PRIVATE_KEY=
NEAR_AGENT_PROPOSAL_FUNCTION_CALL_PRIVATE_KEY=
HANDEL_AGENT_API_TOKEN=
HANDEL_AGENT_MAX_KEY_ALLOWANCE_YOCTO=1000000000000000000000000
HANDEL_DEMO_UNDERLYING_ASSET_ID=nep141:wnear.tidepool-sandbox.testnet
